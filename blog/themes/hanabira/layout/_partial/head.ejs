<%
var title = page.title ? page.title + ' · ' + config.title : config.title;
var desc = page.description || (page.excerpt ? stripHtml(page.excerpt) : (config.description || ''));
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %></title>
<meta name="description" content="<%= desc %>">
<meta name="theme-color" content="#f472b6">
<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:url" content="<%- url_for(page.path) %>">
<% if (page.cover) { %><meta property="og:image" content="<%- url_for(page.cover) %>"><% } %>
<meta name="twitter:card" content="summary">
<link rel="icon" href="<%- url_for('/images/favicon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>">