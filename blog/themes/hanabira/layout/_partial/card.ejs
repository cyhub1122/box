<article class="post-card glass reveal">
  <a class="cover" href="<%- url_for(post.path) %>" aria-hidden="true" tabindex="-1">
    <% if (post.cover) { %>
      <img src="<%- url_for(post.cover) %>" alt="<%= post.title %>" loading="lazy">
    <% } else { %>
      <span class="cover-fallback"><%= post.title.charAt(0) %></span>
    <% } %>
    <% if (post.categories && post.categories.length) { %>
      <span class="cat-badge"><%= post.categories.first().name %></span>
    <% } %>
  </a>
  <div class="body">
    <div class="meta">
      <span><svg viewBox="0 0 24 24"><use href="#i-calendar"></use></svg><%= date(post.date, 'YYYY-MM-DD') %></span>
      <span><svg viewBox="0 0 24 24"><use href="#i-clock"></use></svg><%= readingTime(post.content) %> 分钟</span>
      <span><svg viewBox="0 0 24 24"><use href="#i-pen"></use></svg><%= wordCount(post.content) %> 字</span>
    </div>
    <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
    <% if (theme.card.show_excerpt !== false) { %>
      <p class="excerpt"><%= postExcerpt(post) %></p>
    <% } %>
    <% if (post.tags && post.tags.length) { %>
      <div class="tags">
        <% post.tags.limit(4).each(function (t) { %><a class="pill" href="<%- url_for(t.path) %>"># <%= t.name %></a><% }) %>
      </div>
    <% } %>
  </div>
</article>